!(import! &self (library lib_import))
!(git-import! "https://github.com/singnet/Omega.git")
!(import! &self (library Omega ./src/config.py))
!(import! &self (library Omega ./src/providers.py))
!(import! &self (library Omega ./src/providers))
!(import! &self "__BRIDGE__")
!(py-call (local_provider_bridge.register))
!(llmProviderStart LocalBounded)
!(change-state! &bounded-response (llmProviderChat (py-call (local_provider_bridge.request))))
!(test (llmResponseIsEmpty (get-state &bounded-response)) false)
!(test (py-call (providers.llmResponseIsError (get-state &bounded-response))) false)
!(test (py-call (local_provider_bridge.structurally_valid (get-state &bounded-response))) true)
!(change-state! &expected-answer (+ 2 2))
!(test (get-state &expected-answer) 4)
!(change-state! &gated-response (py-call (local_provider_bridge.arithmetic_gate (get-state &bounded-response) (get-state &expected-answer))))
!(test (py-call (local_provider_bridge.gate_consistent (get-state &bounded-response) (get-state &gated-response) (get-state &expected-answer))) true)
!(py-call (local_provider_bridge.save_report (get-state &bounded-response) (get-state &gated-response) (get-state &expected-answer)))
!(py-call (local_provider_bridge.stop))
