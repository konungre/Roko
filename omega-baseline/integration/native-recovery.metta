!(import! &self "__BRIDGE__")
!(test (py-call (recovery_bridge.recover)) true)
!(test (py-call (recovery_bridge.phase 0)) open)
!(test (py-call (recovery_bridge.phase 1)) closed)
!(test (py-call (recovery_bridge.revision 0)) 1)
!(test (py-call (recovery_bridge.revision 1)) 1)
!(test (py-call (recovery_bridge.unapproved)) true)
!(test (py-call (recovery_bridge.no_actions)) true)
!(test (py-call (recovery_bridge.save)) true)
