!(import! &self "__BRIDGE__")
!(test (py-call (live_controller_bridge.start)) true)
!(test (py-call (live_controller_bridge.run_case 0)) true)
!(test (py-call (live_controller_bridge.consistent 0)) true)
!(test (py-call (live_controller_bridge.isolated 0)) true)
