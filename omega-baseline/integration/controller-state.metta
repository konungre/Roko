!(import! &self "__BRIDGE__")
!(test (py-call (controller_bridge.initialize)) true)
!(test (py-call (controller_bridge.replay_model)) false)
!(test (py-call (controller_bridge.phase)) open)
!(test (py-call (controller_bridge.deterministic_proposal)) true)
!(test (py-call (controller_bridge.phase)) verified)
!(test (py-call (controller_bridge.permission)) false)
!(test (py-call (controller_bridge.close)) true)
!(test (py-call (controller_bridge.phase)) closed)
!(test (py-call (controller_bridge.isolated)) true)
!(test (py-call (controller_bridge.save)) true)
