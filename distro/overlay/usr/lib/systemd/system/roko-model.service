[Unit]
Description=Roko offline model worker (integration contract)
ConditionFileIsExecutable=/opt/roko/bin/roko-model-worker
ConditionPathExists=/opt/roko/models/manifest.json
After=local-fs.target

[Service]
Type=exec
User=roko-model
Group=roko-model
ExecStart=/opt/roko/bin/roko-model-worker
WorkingDirectory=/var/lib/roko-model
StateDirectory=roko-model
StateDirectoryMode=0700
RuntimeDirectory=roko-model
RuntimeDirectoryMode=0700
Environment=HOME=/var/lib/roko-model XDG_STATE_HOME=/var/lib/roko-model
Environment=ROKO_MODEL_ROOT=/opt/roko/models ROKO_SOCKET=/run/roko-model/worker.sock
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
MemoryHigh=16G
MemoryMax=20G
MemorySwapMax=0
TasksMax=128
LimitNOFILE=1024
TimeoutStopSec=30
KillMode=control-group
Restart=no
# Deliberately no Install section: explicit qualification/start only.
