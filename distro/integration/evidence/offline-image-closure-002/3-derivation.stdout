    "env": {
      "__json": "{\"allowSubstitutes\":false,\"buildCommand\":\"mkdir $out\\n\\n# This must not be a symlink or the abs_path of the grub builder for the tests\\n# will resolve the symlink and we end up with a path that doesn't point to a\\n# system closure.\\ncp \\\"$systemd/lib/systemd/systemd\\\" $out/init\\n\\ncp /workspace/scratch/nix-live-001/direct-store/dsilyw6044h3mc5j6xaz9396ay3dkcpy-stage-2-init.sh $out/prepare-root\\nsubstituteInPlace $out/prepare-root --subst-var-by systemConfig $out\\n\\n\\n\\nln -s /workspace/scratch/nix-live-001/direct-store/q109hb5klghm5lcvrsfm04na5ll3i78l-etc/etc $out/etc\\n\\nln -s /workspace/scratch/nix-live-001/direct-store/9xhixn4l8ak87jfsyzb61cya5lm5aq3g-system-path $out/sw\\nln -s \\\"$systemd\\\" $out/systemd\\n\\necho -n \\\"systemd 2\\\" > $out/init-interface-version\\necho -n \\\"$nixosLabel\\\" > $out/nixos-version\\necho -n \\\"x86_64-linux\\\" > $out/system\\n\\nif [ ! -f /workspace/scratch/nix-live-001/direct-store/y8nfwisxx98arw4jm78pq16wxl0haz78-linux-6.18.62/bzImage ]; then\\n  echo \\\"The bootloader cannot find the proper kernel image.\\\"\\n  echo \\\"(Expecting /workspace/scratch/nix-live-001/direct-store/y8nfwisxx98arw4jm78pq16wxl0haz78-linux-6.18.62/bzImage)\\\"\\n  false\\nfi\\n\\nln -s /workspace/scratch/nix-live-001/direct-store/y8nfwisxx98arw4jm78pq16wxl0haz78-linux-6.18.62/bzImage $out/kernel\\nln -s /workspace/scratch/nix-live-001/direct-store/mfdlr35psflajz5i2g3zm82n40mylwdq-linux-6.18.62-modules $out/kernel-modules\\n\\n\\necho -n \\\"${kernelParams[@]}\\\" > $out/kernel-params\\n\\nln -s /workspace/scratch/nix-live-001/direct-store/cw9bhmszvxc5xf8b19yxlc0hfnkydmh3-initrd-linux-6.18.62/initrd $out/initrd\\n\\n\\n\\n\\nln -s /workspace/scratch/nix-live-001/direct-store/avcnbrnkav9xhz0051b5qzjmlamq8k1h-firmware/lib/firmware $out/firmware\\n\\n\\nln -s /workspace/scratch/nix-live-001/direct-store/j0c9v09vcqpzm27nakwgmh39zcnk1pqd-switch-inhibitors $out/switch-inhibitors\\n\\nmkdir $out/specialisation\\n\\n\\n(\\n  source /workspace/scratch/nix-live-001/direct-store/nhmdmpb6pzjrwxc1hab9mrwy6ws9bcg8-make-shell-wrapper-hook/nix-support/setup-hook\\n\\n  mkdir $out/bin\\n  ln -sf /workspace/scratch/nix-live-001/direct-store/mbjqqfxhd795jrhrp552ynbmq2hf5a0a-switch-to-configuration-0.1.0/bin/switch-to-configuration $out/bin/switch-to-configuration\\n  wrapProgram $out/bin/switch-to-configuration \\\\\\n    --set OUT $out \\\\\\n    --set TOPLEVEL ${!toplevelVar} \\\\\\n    --set DISTRO_ID nixos \\\\\\n    --set INSTALL_BOOTLOADER /workspace/scratch/nix-live-001/direct-store/qmy20r0f8ib0lggnkza4ngi0qg9g1vf3-no-bootloader \\\\\\n    --set PRE_SWITCH_CHECK /workspace/scratch/nix-live-001/direct-store/1kz6b71vj133wflndmvr4hs731dy45bi-pre-switch-checks/bin/pre-switch-checks \\\\\\n    --set LOCALE_ARCHIVE /workspace/scratch/nix-live-001/direct-store/jjnn1rnib8a5ggrdijlcickb8b8p775j-glibc-locales-2.44-57/lib/locale/locale-archive \\\\\\n    --set SYSTEMD /workspace/scratch/nix-live-001/direct-store/xr4rv1rqswaiks3wyxbb9c8v2pnfsndh-systemd-262\\n)\\n\\ncp /workspace/scratch/nix-live-001/direct-store/lbqnngx2qd1ngnhlm8sjah6rq46g44rj-activate/bin/activate $out/activate\\ncp /workspace/scratch/nix-live-001/direct-store/nfh4m31blzhcd05mcnh9kijbnamk5n32-dry-activate/bin/dry-activate $out/dry-activate\\n/workspace/scratch/nix-live-001/direct-store/hgqjqa84b4jva2pgkb09xbpv2kn01b4m-gnused-4.10/bin/sed --in-place --expression \\\"s|@out@|${!toplevelVar}|g\\\" $out/activate $out/dry-activate\\n\\n\\nprintf \\\"%s \\\" \\\"${extraDependencies[@]}\\\" > \\\"$out/extra-dependencies\\\"\\n\\n/workspace/scratch/nix-live-001/direct-store/3m46vlksipqlicmb712v9xgbzwwqcca0-jq-1.8.2-bin/bin/jq '.\\\"org.nixos.bootspec.v1\\\".toplevel = $toplevel |\\n.\\\"org.nixos.bootspec.v1\\\".init = $init\\n' --sort-keys --arg toplevel /1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9 --arg init /1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9/init < /workspace/scratch/nix-live-001/direct-store/xldms0vg